# Settings of the Anki&Claude MCP server for use OUTSIDE the Claude Code plugin
# (as a plugin, Claude Code passes these from its own configuration).
# Copy to %APPDATA%\anki-claude\.env (Windows), ~/Library/Application Support/anki-claude/.env (macOS),
# ~/.config/anki-claude/.env (Linux), or point ANKI_CLAUDE_ENV_FILE at it.
# Real environment variables override this file.

ANKI_ROOT_DECK=Study
ANKI_CONNECT_URL=http://127.0.0.1:8765
# ANKI_CONNECT_KEY=
ANKI_EXPLANATION_LANGUAGE=uk
ANKI_ENGLISH_LEVEL=B1
ANKI_ENGLISH_GOAL=C1
ANKI_EXAMPLE_LEVEL=B1-B2
ANKI_MAX_CARDS_PER_BATCH=15
ANKI_PROMOTE_AFTER_DAYS=3
ANKI_AUTO_SYNC=true
ANKI_TTS=true
ANKI_TTS_LANG=en_US
ANKI_REVIEW_REMINDER=true
ANKI_SOUND_ON_STOP=false
